# Copy to .env and adjust.
POSTGRES_USER=conciliador
POSTGRES_PASSWORD=conciliador
POSTGRES_DB=autoconciliador

# Host port to publish Postgres on (container port stays 5432). 5433 avoids
# clashing with a local Postgres already on 5432.
DB_HOST_PORT=5433

# Async DSN used by SQLAlchemy/asyncpg. Host = db service name inside Docker network.
DATABASE_URL=postgresql+asyncpg://conciliador:conciliador@db:5432/autoconciliador

# For running Alembic/local scripts against the container from host, use localhost:
# DATABASE_URL=postgresql+asyncpg://conciliador:conciliador@localhost:5433/autoconciliador

# Separate DB for the test suite (pytest), so committing-style tests never
# touch dev data. Create once: `docker compose exec db createdb -U conciliador autoconciliador_test`
# then `alembic upgrade head` against it.
TEST_DATABASE_URL=postgresql+asyncpg://conciliador:conciliador@db:5432/autoconciliador_test

# --- JWT auth (Phase 4) ---
# Generate a strong secret: `openssl rand -hex 32`
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated CORS origins (Vue frontend, Phase 5).
CORS_ORIGINS=http://localhost:5173

# --- Seed admin (used by scripts/seed_admin.py) ---
SEED_ADMIN_EMAIL=admin@autoconciliador.local
SEED_ADMIN_PASSWORD=Cambiar-Esta-Clave-123

# --- Frontend (Phase 5, used by docker-compose's frontend service) ---
VITE_API_BASE_URL=http://localhost:8000/api

# --- StatementReviewer (tier 2, LLM second opinion — see llm_reviewer.py) ---
# Off by default. Target deploy: same Hostinger VPS as the backend, CPU-only
# (2 vCPU/8GB plan) — this backend only ever speaks HTTP to an OpenAI-compatible
# endpoint (Ollama/llama.cpp/vLLM), so a GPU box remains a valid alternative
# deploy that only changes these vars. granite4.1:3b is sized for CPU latency:
# a 7-8B model on 2 vCPU takes ~2.5-3 min per verdict, past any sane timeout.
# See docs/IMPLEMENTACION-IA-VERIFICACION-EXTRACTOS.md § Consumo y dimensionamiento.
LLM_REVIEW_ENABLED=False
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=granite4.1:3b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90.0
LLM_MAX_LINEAS_CONTEXTO=40

# --- Ollama server env vars (set where Ollama itself runs, NOT read by this
# backend) — keep the model out of resident RAM between the rare escalations,
# and leave one vCPU free for Postgres/FastAPI during generation. ---
# OLLAMA_KEEP_ALIVE=0
# OLLAMA_NUM_THREAD=1
